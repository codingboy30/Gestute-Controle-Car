#include <Wire.h>
#include <ESP8266WiFi.h>

extern "C" {
  #include <espnow.h>
  #include "user_interface.h"
}

// ESP32 receiver MAC address
uint8_t receiverMac[] = {
  0xB4, 0xBF, 0xE9,
  0x12, 0x48, 0x94
};

#define ESPNOW_CHANNEL 1
#define MPU_ADDR 0x68
#define GESTURE_THRESHOLD 5000

#define STOP      0
#define FORWARD   1
#define BACKWARD  2
#define LEFT      3
#define RIGHT     4

struct ControlData {
  int16_t ax, ay, az;
  int16_t gx, gy, gz;
  uint8_t command;
};

ControlData data = {};

void writeMPU(uint8_t reg, uint8_t value) {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(reg);
  Wire.write(value);
  Wire.endTransmission();
}

int16_t read16() {
  uint8_t highByte = Wire.read();
  uint8_t lowByte = Wire.read();
  return (int16_t)((highByte << 8) | lowByte);
}

bool readMPU() {
  Wire.beginTransmission(MPU_ADDR);
  Wire.write(0x3B);
  if (Wire.endTransmission(false) != 0) return false;

  if (Wire.requestFrom(MPU_ADDR, 14) != 14) return false;

  data.ax = read16();
  data.ay = read16();
  data.az = read16();

  read16(); // Discard temperature reading

  data.gx = read16();
  data.gy = read16();
  data.gz = read16();

  return true;
}

uint8_t detectGesture() {
  if (data.ay > GESTURE_THRESHOLD)  return FORWARD;
  if (data.ay < -GESTURE_THRESHOLD) return BACKWARD;
  if (data.ax > GESTURE_THRESHOLD)  return RIGHT;
  if (data.ax < -GESTURE_THRESHOLD) return LEFT;
  return STOP;
}

const char* commandName(uint8_t command) {
  switch (command) {
    case FORWARD:  return "FORWARD";
    case BACKWARD: return "BACKWARD";
    case LEFT:     return "LEFT";
    case RIGHT:    return "RIGHT";
    default:       return "STOP";
  }
}

void onDataSent(uint8_t* mac, uint8_t status) {
  Serial.println(status == 0 ? "ESP-NOW: SENT" : "ESP-NOW: FAILED");
}

void setup() {
  Serial.begin(115200);
  delay(500);

  Serial.println("\nGESTURE CAR - ESP8266 TRANSMITTER");

  Wire.begin(D2, D1);
  Wire.setClock(100000);

  // Wake up MPU6050; accelerometer range = +/-2g
  writeMPU(0x6B, 0x00);
  writeMPU(0x1C, 0x00);
  delay(100);

  if (!readMPU()) {
    Serial.println("MPU6050 not responding. Check wiring/address.");
  } else {
    Serial.println("MPU6050 responding.");
  }

  WiFi.mode(WIFI_STA);
  wifi_set_channel(ESPNOW_CHANNEL);
  delay(100);

  Serial.print("ESP8266 MAC: ");
  Serial.println(WiFi.macAddress());

  if (esp_now_init() != 0) {
    Serial.println("ESP-NOW INIT FAILED!");
    while (true) delay(1000);
  }

  esp_now_set_self_role(ESP_NOW_ROLE_CONTROLLER);
  esp_now_register_send_cb(onDataSent);

  int result = esp_now_add_peer(
    receiverMac,
    ESP_NOW_ROLE_SLAVE,
    ESPNOW_CHANNEL,
    NULL,
    0
  );

  if (result != 0) {
    Serial.print("Peer add failed: ");
    Serial.println(result);
    while (true) delay(1000);
  }

  Serial.println("ESP-NOW READY");
  Serial.println("Move the MPU6050 to control the car.");
}

void loop() {
  if (!readMPU()) {
    data.command = STOP;
    Serial.println("MPU6050 READ FAILED");
  } else {
    data.command = detectGesture();
  }

  Serial.print("AX=");
  Serial.print(data.ax);
  Serial.print(" AY=");
  Serial.print(data.ay);
  Serial.print(" COMMAND=");
  Serial.println(commandName(data.command));

  uint8_t result = esp_now_send(
    receiverMac,
    (uint8_t*)&data,
    sizeof(data)
  );

  if (result != 0) {
    Serial.println("Send function failed");
  }

  delay(100);
}
