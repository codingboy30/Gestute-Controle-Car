#include <WiFi.h>
#include <esp_now.h>
#include <esp_wifi.h>

// ==========================================
// L298N PIN CONNECTIONS
// ==========================================

#define ENA 26
#define IN1 27
#define IN2 14

#define ENB 25
#define IN3 33
#define IN4 32

// ==========================================
// COMMANDS
// ==========================================

#define STOP      0
#define FORWARD   1
#define BACKWARD  2
#define LEFT      3
#define RIGHT     4

// ==========================================
// SETTINGS
// ==========================================

#define MOTOR_SPEED 200       // PWM: 0-255
#define PWM_FREQUENCY 1000
#define PWM_RESOLUTION 8
#define FAILSAFE_TIME 500
#define ESPNOW_CHANNEL 1

// ==========================================
// DATA PACKET
// Must match ESP8266 exactly
// ==========================================

struct ControlData {
  int16_t ax, ay, az;
  int16_t gx, gy, gz;
  uint8_t command;
};

ControlData receivedData = {};

volatile unsigned long lastPacketTime = 0;
volatile bool packetReceived = false;

portMUX_TYPE packetMux = portMUX_INITIALIZER_UNLOCKED;

// ==========================================
// COMMAND NAME
// ==========================================

const char* commandName(uint8_t command) {
  switch (command) {
    case FORWARD:  return "FORWARD";
    case BACKWARD: return "BACKWARD";
    case LEFT:     return "LEFT";
    case RIGHT:    return "RIGHT";
    default:       return "STOP";
  }
}

// ==========================================
// STOP MOTORS
// ==========================================

void stopCar() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);

  ledcWrite(ENA, 0);
  ledcWrite(ENB, 0);
}

// ==========================================
// FORWARD
// ==========================================

void moveForward() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);

  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);

  ledcWrite(ENA, MOTOR_SPEED);
  ledcWrite(ENB, MOTOR_SPEED);
}

// ==========================================
// BACKWARD
// ==========================================

void moveBackward() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);

  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);

  ledcWrite(ENA, MOTOR_SPEED);
  ledcWrite(ENB, MOTOR_SPEED);
}

// ==========================================
// TURN LEFT
// ==========================================

void turnLeft() {
  // Left side backward
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);

  // Right side forward
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);

  ledcWrite(ENA, MOTOR_SPEED);
  ledcWrite(ENB, MOTOR_SPEED);
}

// ==========================================
// TURN RIGHT
// ==========================================

void turnRight() {
  // Left side forward
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);

  // Right side backward
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);

  ledcWrite(ENA, MOTOR_SPEED);
  ledcWrite(ENB, MOTOR_SPEED);
}

// ==========================================
// EXECUTE COMMAND
// ==========================================

void executeCommand(uint8_t command) {
  switch (command) {
    case FORWARD:
      moveForward();
      break;

    case BACKWARD:
      moveBackward();
      break;

    case LEFT:
      turnLeft();
      break;

    case RIGHT:
      turnRight();
      break;

    default:
      stopCar();
      break;
  }
}

// ==========================================
// ESP-NOW RECEIVE CALLBACK
// Arduino-ESP32 3.x
// ==========================================

void onDataReceive(
  const esp_now_recv_info_t *info,
  const uint8_t *incomingData,
  int len
) {
  if (len != sizeof(ControlData)) {
    return;
  }

  ControlData packet;
  memcpy(&packet, incomingData, sizeof(packet));

  if (packet.command > RIGHT) {
    return;
  }

  portENTER_CRITICAL(&packetMux);
  receivedData = packet;
  lastPacketTime = millis();
  packetReceived = true;
  portEXIT_CRITICAL(&packetMux);
}

// ==========================================
// SETUP
// ==========================================

void setup() {
  Serial.begin(115200);
  delay(500);

  Serial.println("\nGESTURE CAR - ESP32 RECEIVER");

  // Motor direction pins
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  stopCar();

  // Attach PWM to enable pins
  bool pwmA = ledcAttach(
    ENA, PWM_FREQUENCY, PWM_RESOLUTION
  );

  bool pwmB = ledcAttach(
    ENB, PWM_FREQUENCY, PWM_RESOLUTION
  );

  if (!pwmA || !pwmB) {
    Serial.println("PWM setup failed. Check pins/core.");
    while (true) {
      stopCar();
      delay(1000);
    }
  }

  stopCar();

  // Wi-Fi station mode
  WiFi.mode(WIFI_STA);
  WiFi.disconnect();

  // Match transmitter's ESP-NOW channel
  esp_err_t channelResult = esp_wifi_set_channel(
    ESPNOW_CHANNEL,
    WIFI_SECOND_CHAN_NONE
  );

  if (channelResult != ESP_OK) {
    Serial.println("Could not set Wi-Fi channel!");
    while (true) delay(1000);
  }

  Serial.print("ESP32 MAC: ");
  Serial.println(WiFi.macAddress());

  // Initialize ESP-NOW
  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP-NOW INIT FAILED!");
    while (true) delay(1000);
  }

  esp_now_register_recv_cb(onDataReceive);

  Serial.println("ESP-NOW READY");
  Serial.println("Waiting for transmitter...");
}

// ==========================================
// LOOP
// ==========================================

void loop() {
  ControlData packet;
  bool newPacket = false;
  unsigned long lastTime;

  portENTER_CRITICAL(&packetMux);
  if (packetReceived) {
    packet = receivedData;
    packetReceived = false;
    newPacket = true;
  }
  lastTime = lastPacketTime;
  portEXIT_CRITICAL(&packetMux);

  if (millis() - lastTime > FAILSAFE_TIME) {
    stopCar();
    delay(5);
    return;
  }

  if (newPacket) {
    Serial.print("COMMAND RECEIVED: ");
    Serial.println(commandName(packet.command));

    executeCommand(packet.command);
  }

  delay(5);
}
